<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
  <top>
    <HBox styleClass="search-bar" spacing="10" alignment="CENTER_LEFT">
      <TextField fx:id="query" HBox.hgrow="ALWAYS" maxWidth="Infinity" promptText="输入关键词搜索" onAction="#onSearch" styleClass="search-field"/>
      <ComboBox fx:id="scope" prefWidth="130"/>
      <Button text="搜索" onAction="#onSearch" styleClass="accent"/>
    </HBox>
  </top>
  <center>
    <SplitPane dividerPositions="0.24" orientation="HORIZONTAL">
      <ScrollPane fitToWidth="true" styleClass="facet-panel">
        <VBox fx:id="facetBox" styleClass="facet-box" spacing="6">
          <HBox alignment="CENTER_LEFT">
            <Label text="筛选" styleClass="facet-header" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
            <Hyperlink fx:id="clearFilters" text="清除" visible="false" managed="false"/>
          </HBox>
          <Label text="分类" styleClass="section-title"/>
          <VBox fx:id="categoryFacets" spacing="2"/>
          <Label text="状态" styleClass="section-title"/>
          <VBox fx:id="statusFacets" spacing="2"/>
          <Label fx:id="facetHint" text="先在「总览」页添加并打开仓库" styleClass="facet-count" wrapText="true" managed="false" visible="false"/>
        </VBox>
      </ScrollPane>
      <VBox styleClass="page" spacing="8">
        <Label fx:id="resultSummary" styleClass="result-summary" visible="false" managed="false"/>
        <ListView fx:id="results" VBox.vgrow="ALWAYS"/>
      </VBox>
    </SplitPane>
  </center>
</BorderPane>
