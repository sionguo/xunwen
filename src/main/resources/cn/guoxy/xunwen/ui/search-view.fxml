<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
  <top>
    <HBox styleClass="search-bar" spacing="10" alignment="CENTER_LEFT">
      <TextField fx:id="query" HBox.hgrow="ALWAYS" maxWidth="Infinity" promptText="输入关键词搜索" onAction="#onSearch"/>
      <ComboBox fx:id="scope" prefWidth="130"/>
      <Button text="搜索" onAction="#onSearch" styleClass="accent"/>
    </HBox>
  </top>
  <center>
    <VBox styleClass="page">
      <ListView fx:id="results" VBox.vgrow="ALWAYS"/>
    </VBox>
  </center>
</BorderPane>
