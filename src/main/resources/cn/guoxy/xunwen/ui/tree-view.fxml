<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.ToolBar?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.control.TreeView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
  <top>
    <ToolBar styleClass="search-bar">
      <Button fx:id="generateBtn" text="生成类别树提案" onAction="#onGenerateProposal" styleClass="accent"/>
      <Button fx:id="approveBtn" text="批准入树" onAction="#onApproveProposal"/>
      <Button fx:id="discardBtn" text="放弃提案" onAction="#onDiscardProposal"/>
      <Separator orientation="VERTICAL"/>
      <Button fx:id="reshuffleBtn" text="重排仓库" onAction="#onReshuffle" styleClass="accent"/>
      <Button fx:id="cancelBtn" text="取消重排" onAction="#onCancelReshuffle" disable="true" styleClass="danger"/>
    </ToolBar>
  </top>
  <center>
    <VBox styleClass="page">
      <StackPane VBox.vgrow="ALWAYS">
        <TreeView fx:id="tree"/>
        <Label fx:id="treeHint" styleClass="placeholder-label" mouseTransparent="true"/>
      </StackPane>
    </VBox>
  </center>
  <bottom>
    <HBox styleClass="status-bar" spacing="10" alignment="CENTER_LEFT">
      <ProgressBar fx:id="progress" prefWidth="220" visible="false"/>
      <Label fx:id="status"/>
    </HBox>
  </bottom>
</BorderPane>
