<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<VBox spacing="10" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
  <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
  <HBox spacing="10">
    <Button text="添加仓库" onAction="#onAdd"/>
    <Button text="打开" onAction="#onOpen"/>
    <Button text="移除" onAction="#onRemove"/>
  </HBox>
  <ListView fx:id="repoList" prefHeight="480"/>
</VBox>
