<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>
<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
  <top>
    <HBox styleClass="top-bar" spacing="10" alignment="CENTER_LEFT">
      <Label text="寻文" styleClass="app-title"/>
      <Label fx:id="currentRepoLabel" styleClass="app-repo"/>
      <Label fx:id="activityLabel" styleClass="app-activity" HBox.hgrow="ALWAYS" maxWidth="Infinity" textOverrun="CLIP"/>
    </HBox>
  </top>
  <left>
    <VBox styleClass="nav-sidebar">
      <fx:define>
        <ToggleGroup fx:id="navGroup"/>
      </fx:define>
      <ToggleButton fx:id="overviewBtn" text="总览" toggleGroup="$navGroup" styleClass="nav-button">
        <graphic><FontIcon iconLiteral="fas-tachometer-alt" iconSize="15"/></graphic>
      </ToggleButton>
      <ToggleButton fx:id="treeBtn" text="类别树" toggleGroup="$navGroup" styleClass="nav-button">
        <graphic><FontIcon iconLiteral="fas-sitemap" iconSize="15"/></graphic>
      </ToggleButton>
      <ToggleButton fx:id="pendingBtn" text="待审" toggleGroup="$navGroup" styleClass="nav-button">
        <graphic><FontIcon iconLiteral="fas-inbox" iconSize="15"/></graphic>
      </ToggleButton>
      <ToggleButton fx:id="searchBtn" text="搜索" toggleGroup="$navGroup" styleClass="nav-button">
        <graphic><FontIcon iconLiteral="fas-search" iconSize="15"/></graphic>
      </ToggleButton>
      <ToggleButton fx:id="settingsBtn" text="设置" toggleGroup="$navGroup" styleClass="nav-button">
        <graphic><FontIcon iconLiteral="fas-cog" iconSize="15"/></graphic>
      </ToggleButton>
    </VBox>
  </left>
  <center>
    <StackPane fx:id="content" prefWidth="900"/>
  </center>
</BorderPane>
