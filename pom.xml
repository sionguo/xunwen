<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>cn.guoxy</groupId>
  <artifactId>xunwen</artifactId>
  <version>1.0-SNAPSHOT</version>
  <name>xunwen</name>

  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <properties>
    <java.version>25</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

    <javafx.version>27</javafx.version>
    <lucene.version>10.5.2</lucene.version>
    <jspecify.version>1.0.1</jspecify.version>
    <jackson.version>3.2.4</jackson.version>
    <tika.version>4.1.0</tika.version>

    <junit.version>5.12.1</junit.version>

    <!-- 打包发布属性:非当前 OS 的平台参数保持空值/false,插件会自动跳过(见 dist profile) -->
    <jpackage.type>PLATFORM</jpackage.type>
    <jpackage.icon>${project.basedir}/packaging/Xunwen.png</jpackage.icon>
    <jpackage.mac.package.name/>
    <jpackage.mac.identifier/>
    <jpackage.win.menu>false</jpackage.win.menu>
    <jpackage.win.shortcut>false</jpackage.win.shortcut>
    <jpackage.win.peruser>false</jpackage.win.peruser>
    <jpackage.win.uuid/>
    <jpackage.linux.maintainer/>
    <jpackage.linux.shortcut>false</jpackage.linux.shortcut>
    <jpackage.linux.menu/>
    <jpackage.linux.category/>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-controls</artifactId>
      <version>${javafx.version}</version>
    </dependency>
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-fxml</artifactId>
      <version>${javafx.version}</version>
    </dependency>

    <dependency>
      <groupId>org.controlsfx</groupId>
      <artifactId>controlsfx</artifactId>
      <version>11.2.1</version>
    </dependency>
    <dependency>
      <groupId>org.kordamp.ikonli</groupId>
      <artifactId>ikonli-javafx</artifactId>
      <version>12.3.1</version>
    </dependency>
    <dependency>
      <groupId>org.kordamp.ikonli</groupId>
      <artifactId>ikonli-fontawesome5-pack</artifactId>
      <version>12.3.1</version>
    </dependency>
    <dependency>
      <groupId>io.github.mkpaz</groupId>
      <artifactId>atlantafx-base</artifactId>
      <version>3.0.0</version>
    </dependency>

    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
      <version>2.0.20</version>
    </dependency>
    <dependency>
      <groupId>ch.qos.logback</groupId>
      <artifactId>logback-classic</artifactId>
      <version>1.3.14</version>
    </dependency>

    <dependency>
      <groupId>org.apache.lucene</groupId>
      <artifactId>lucene-core</artifactId>
      <version>${lucene.version}</version>
    </dependency>
    <dependency>
      <groupId>org.apache.lucene</groupId>
      <artifactId>lucene-highlighter</artifactId>
      <version>${lucene.version}</version>
    </dependency>
    <dependency>
      <groupId>org.apache.lucene</groupId>
      <artifactId>lucene-queryparser</artifactId>
      <version>${lucene.version}</version>
    </dependency>
    <dependency>
      <groupId>org.apache.lucene</groupId>
      <artifactId>lucene-analysis-smartcn</artifactId>
      <version>${lucene.version}</version>
    </dependency>
    <dependency>
      <groupId>tools.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>${jackson.version}</version>
    </dependency>
    <dependency>
      <groupId>tools.jackson.dataformat</groupId>
      <artifactId>jackson-dataformat-yaml</artifactId>
      <version>${jackson.version}</version>
    </dependency>
    <dependency>
      <groupId>org.apache.tika</groupId>
      <artifactId>tika-parsers-standard-package</artifactId>
      <version>${tika.version}</version>
      <type>pom</type>
    </dependency>
    <dependency>
      <groupId>org.apache.tika</groupId>
      <artifactId>tika-pipes-fork-parser</artifactId>
      <version>${tika.version}</version>
      <exclusions>
        <exclusion> <!-- 保 SLF4J 唯一 provider = logback，防 log4j-slf4j2-impl 抢绑定 -->
          <groupId>org.apache.logging.log4j</groupId>
          <artifactId>log4j-slf4j2-impl</artifactId>
        </exclusion>
      </exclusions>
    </dependency>

    <dependency>
      <groupId>org.jspecify</groupId>
      <artifactId>jspecify</artifactId>
      <version>${jspecify.version}</version>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-api</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-engine</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testfx</groupId>
      <artifactId>testfx-junit5</artifactId>
      <version>4.0.18</version>
      <scope>test</scope>
    </dependency>
    <!-- OCR 兜底(JiaJiaOCR = PaddleOCR ONNX 纯 Java 封装,模型捆绑在其 jar 内):
         本地仓库安装:mvn install:install-file -Dfile=JiaJiaOCR-2.2.0.jar
           -DgroupId=com.jiajia -DartifactId=JiaJia -Dversion=2.2.0 -Dpackaging=jar -->
    <dependency>
      <groupId>com.jiajia</groupId>
      <artifactId>JiaJia</artifactId>
      <version>2.2.0</version>
    </dependency>
    <dependency>
      <groupId>com.microsoft.onnxruntime</groupId>
      <artifactId>onnxruntime</artifactId>
      <version>1.19.0</version>
    </dependency>
    <dependency>
      <groupId>org.openpnp</groupId>
      <artifactId>opencv</artifactId>
      <version>4.9.0-0</version>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
        <configuration>
          <source>${java.version}</source>
          <target>${java.version}</target>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.2</version>
        <configuration> <!-- 防 fork 子进程拿到 manifest-only 假 classpath：surefire 默认用 manifest jar 启动 -->
          <useSystemClassLoader>false</useSystemClassLoader>
          <!-- 启用 JDK Vector API，消除 Lucene 向量检索降级警告并提升 KNN 性能 -->
          <argLine>--add-modules jdk.incubator.vector</argLine>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.openjfx</groupId>
        <artifactId>javafx-maven-plugin</artifactId>
        <version>0.0.8</version>
        <executions>
          <execution>
            <!-- Default configuration for running with: mvn clean javafx:run -->
            <id>default-cli</id>
            <configuration>
              <mainClass>cn.guoxy.xunwen.Launcher</mainClass>
              <launcher>app</launcher>
              <jlinkZipName>app</jlinkZipName>
              <jlinkImageName>app</jlinkImageName>
              <noManPages>true</noManPages>
              <stripDebug>true</stripDebug>
              <noHeaderFiles>true</noHeaderFiles>
              <!-- 启用 JDK Vector API，消除 Lucene 向量检索降级警告并提升 KNN 性能 -->
              <options>
                <option>--add-modules jdk.incubator.vector</option>
              </options>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.4.2</version>
        <configuration>
          <archive>
            <manifest>
              <!-- jpackage 以 classpath 方式启动时按此入口运行(Launcher 与 JavaFX 解耦) -->
              <mainClass>cn.guoxy.xunwen.Launcher</mainClass>
            </manifest>
          </archive>
        </configuration>
      </plugin>
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>3.8.0</version>
        <executions>
          <execution>
            <id>spotless-check</id>
            <goals>
              <goal>check</goal>
            </goals>
            <phase>verify</phase>
          </execution>
        </executions>
        <configuration>
          <java>
            <googleJavaFormat>
              <version>1.33.0</version>
              <style>GOOGLE</style>
              <reflowLongStrings>true</reflowLongStrings>
            </googleJavaFormat>
            <removeUnusedImports/>
          </java>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- 打包发布:mvn -Pdist clean package [-DskipTests] [-Djpackage.type=IMAGE]
         产物在 target/jpackage/(macOS → DMG,Windows → MSI,Linux → DEB);
         -Djpackage.type=IMAGE 只出 Xunwen.app/绿色目录,便于快速验证。
         发布版本号与 project.version 同步维护,见下方 appversion。 -->
    <profile>
      <id>dist</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-jar-plugin</artifactId>
            <configuration>
              <!-- 应用 jar 直接落进 jpackage 的 input 目录,与依赖 jar 同级 -->
              <outputDirectory>${project.build.directory}/jpackage/input</outputDirectory>
            </configuration>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-dependency-plugin</artifactId>
            <version>3.8.1</version>
            <executions>
              <execution>
                <id>copy-deps-for-jpackage</id>
                <phase>prepare-package</phase>
                <goals>
                  <goal>copy-dependencies</goal>
                </goals>
                <configuration>
                  <includeScope>runtime</includeScope>
                  <outputDirectory>${project.build.directory}/jpackage/input</outputDirectory>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>com.github.akman</groupId>
            <artifactId>jpackage-maven-plugin</artifactId>
            <version>0.1.5</version>
            <configuration>
              <input>${project.build.directory}/jpackage/input</input>
              <mainjar>${project.build.finalName}.jar</mainjar>
              <mainclass>cn.guoxy.xunwen.Launcher</mainclass>
              <name>Xunwen</name>
              <!-- jpackage 要求版本号仅含数字与点,不能带 SNAPSHOT -->
              <appversion>1.0</appversion>
              <vendor>Guo Xiaoyong</vendor>
              <description>寻文 — 基于 Lucene 的本地文档智能检索桌面应用</description>
              <copyright>Copyright (C) 2026 Guo Xiaoyong</copyright>
              <icon>${jpackage.icon}</icon>
              <type>${jpackage.type}</type>
              <dest>${project.build.directory}/jpackage</dest>
              <!-- 不传 licensefile:DMG 会因此挂 SLA 协议弹窗,增加安装摩擦;
                   许可文本随源码 LICENSE 分发即可 -->
              <!-- 启用 Vector API 并放行 Lucene mmap 的受限 native 方法 -->
              <javaoptions>
                --add-modules=jdk.incubator.vector --enable-native-access=ALL-UNNAMED
              </javaoptions>
              <macpackagename>${jpackage.mac.package.name}</macpackagename>
              <macpackageidentifier>${jpackage.mac.identifier}</macpackageidentifier>
              <!-- 对外分发需 Developer ID 证书签名 + 公证时,置 true 并补证书配置 -->
              <macsign>false</macsign>
              <winmenu>${jpackage.win.menu}</winmenu>
              <winshortcut>${jpackage.win.shortcut}</winshortcut>
              <winperuserinstall>${jpackage.win.peruser}</winperuserinstall>
              <winupgradeuuid>${jpackage.win.uuid}</winupgradeuuid>
              <linuxdebmaintainer>${jpackage.linux.maintainer}</linuxdebmaintainer>
              <linuxshortcut>${jpackage.linux.shortcut}</linuxshortcut>
              <linuxmenugroup>${jpackage.linux.menu}</linuxmenugroup>
              <linuxappcategory>${jpackage.linux.category}</linuxappcategory>
            </configuration>
            <executions>
              <execution>
                <id>create-installer</id>
                <phase>package</phase>
                <goals>
                  <goal>jpackage</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
    <!-- 以下三个 profile 仅按当前 OS 设定安装包类型与图标文件,不绑定任何执行 -->
    <profile>
      <id>dist-mac</id>
      <activation>
        <os>
          <family>mac</family>
        </os>
      </activation>
      <properties>
        <jpackage.type>DMG</jpackage.type>
        <jpackage.icon>${project.basedir}/packaging/Xunwen.icns</jpackage.icon>
        <jpackage.mac.package.name>Xunwen</jpackage.mac.package.name>
        <jpackage.mac.identifier>cn.guoxy.xunwen</jpackage.mac.identifier>
      </properties>
    </profile>
    <profile>
      <id>dist-win</id>
      <activation>
        <os>
          <family>windows</family>
        </os>
      </activation>
      <properties>
        <jpackage.type>MSI</jpackage.type>
        <jpackage.icon>${project.basedir}/packaging/Xunwen.ico</jpackage.icon>
        <jpackage.win.menu>true</jpackage.win.menu>
        <jpackage.win.shortcut>true</jpackage.win.shortcut>
        <jpackage.win.peruser>true</jpackage.win.peruser>
        <!-- 固定升级码,保证新版 MSI 可覆盖安装旧版 -->
        <jpackage.win.uuid>C997546E-292B-44DE-84BF-2826F26CF6D8</jpackage.win.uuid>
      </properties>
    </profile>
    <profile>
      <id>dist-linux</id>
      <activation>
        <os>
          <family>linux</family>
        </os>
      </activation>
      <properties>
        <jpackage.type>DEB</jpackage.type>
        <jpackage.icon>${project.basedir}/packaging/Xunwen.png</jpackage.icon>
        <jpackage.linux.maintainer>xiguo@corilead.com</jpackage.linux.maintainer>
        <jpackage.linux.shortcut>true</jpackage.linux.shortcut>
        <jpackage.linux.menu>Office</jpackage.linux.menu>
        <jpackage.linux.category>Office</jpackage.linux.category>
      </properties>
    </profile>
  </profiles>
</project>